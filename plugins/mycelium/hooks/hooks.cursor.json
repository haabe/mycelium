{
  "version": 1,
  "_description": "Mycelium hooks for Cursor 1.7+. Translation of hooks.json (Claude Code) to Cursor's camelCase event names. Scripts in this directory are reused verbatim \u2014 Cursor exports CLAUDE_PROJECT_DIR as an env alias and the stdin JSON field names (tool_name, tool_input, file_path, command, cwd) match Claude Code's. Native postToolUseFailure means full reflexion-gate coverage. Symlink or copy this file to <project>/.cursor/hooks.json (or ~/.cursor/hooks.json for user-level).",
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|edit|write",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/gate.sh",
        "type": "command",
        "timeout": 5,
        "failClosed": true
      },
      {
        "matcher": "Write|write",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/discovery-gate.sh",
        "type": "command",
        "timeout": 5
      },
      {
        "matcher": "Write|Edit|MultiEdit|edit|write",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/brownfield-gate.sh",
        "type": "command",
        "timeout": 5
      },
      {
        "matcher": "Write|Edit|MultiEdit|edit|write",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/scope-gate.sh",
        "type": "command",
        "timeout": 5
      },
      {
        "matcher": "Write|Edit|MultiEdit|edit|write|Bash|shell|mcp__filesystem__(write_file|edit_file|move_file)",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/framework-guard.sh",
        "type": "command",
        "timeout": 5
      },
      {
        "matcher": "Write|Edit|MultiEdit|edit|write|mcp__filesystem__(write_file|edit_file|move_file)",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/autonomous-evidence-guard.sh",
        "type": "command",
        "timeout": 5
      },
      {
        "matcher": "Write|Edit|MultiEdit|edit|write",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/absence-claim-guard.sh",
        "type": "command",
        "timeout": 5
      },
      {
        "matcher": "Write|Edit|MultiEdit|edit|write",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/correction-attribution-guard.sh",
        "type": "command",
        "timeout": 5
      },
      {
        "matcher": "Shell",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/shell-safety-guard.sh",
        "type": "command",
        "timeout": 5
      },
      {
        "matcher": "Shell",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/absence-claim-guard.sh",
        "type": "command",
        "timeout": 5
      },
      {
        "matcher": "Shell",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/correction-attribution-guard.sh",
        "type": "command",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|edit|write",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/post-write-nudge.sh",
        "type": "command",
        "timeout": 3
      },
      {
        "matcher": "Write|Edit|MultiEdit|edit|write",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/change-log.sh",
        "type": "command",
        "timeout": 3
      },
      {
        "matcher": "Write|Edit|MultiEdit|edit|write",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/diamond-state-audit.sh",
        "type": "command",
        "timeout": 3
      },
      {
        "matcher": "Read|read",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/read-log.sh",
        "type": "command",
        "timeout": 3
      }
    ],
    "postToolUseFailure": [
      {
        "matcher": "Bash|shell",
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/reflexion-gate.sh",
        "type": "command",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/stop-check.sh",
        "type": "command",
        "timeout": 5
      },
      {
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/ci-signal.sh",
        "type": "command",
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/session-start.sh",
        "type": "command",
        "timeout": 5
      },
      {
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/ci-signal.sh --session-start",
        "type": "command",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/preflight.sh",
        "type": "command",
        "timeout": 5
      },
      {
        "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/discovery-trigger-guard.sh",
        "type": "command"
      }
    ]
  }
}
