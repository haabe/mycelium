{
  "description": "Mycelium 5-layer enforcement architecture wired to Claude Code plugin events. Hook scripts read project state from $CLAUDE_PROJECT_DIR/.claude/ (canvas, memory, decision-log) which the user's project owns; the scripts themselves live in ${CLAUDE_PLUGIN_ROOT}/hooks/ via plugin install.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh",
            "timeout": 30,
            "statusMessage": "Mycelium preflight gate + secret scan"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/discovery-gate.sh",
            "timeout": 30,
            "statusMessage": "Mycelium discovery gate (new source files in discovery-untouched projects)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scale-lock-gate.sh",
            "timeout": 10,
            "statusMessage": "Mycelium scale-lock gate (a new diamond opens only on what its parent established)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/brownfield-gate.sh",
            "timeout": 30,
            "statusMessage": "Mycelium brownfield gate (one-shot: existing code, no discovery state)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scope-gate.sh",
            "timeout": 30,
            "statusMessage": "Mycelium scope enforcement"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/framework-guard.sh",
            "timeout": 30,
            "statusMessage": "Mycelium framework-guard (dogfood-mode only)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/autonomous-evidence-guard.sh",
            "timeout": 30,
            "statusMessage": "Mycelium autonomous-evidence-guard (autonomous-mode only)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/absence-claim-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/key-shape-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/correction-attribution-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/framework-guard.sh",
            "timeout": 30,
            "statusMessage": "Mycelium framework-guard (Bash — dogfood-mode only)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/shell-safety-guard.sh",
            "timeout": 5,
            "statusMessage": "Mycelium framework-guard (Bash — dogfood-mode only)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/absence-claim-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/correction-attribution-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh",
            "timeout": 30,
            "statusMessage": "Mycelium preflight gate + secret scan"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/discovery-gate.sh",
            "timeout": 30,
            "statusMessage": "Mycelium discovery gate (new source files in discovery-untouched projects)"
          },
          {
            "type": "command",
            "timeout": 10,
            "statusMessage": "Mycelium exposure gate (a deploy waits for Deliver with Security and Privacy passed)",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/exposure-gate.sh"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/brownfield-gate.sh",
            "timeout": 30,
            "statusMessage": "Mycelium brownfield gate (one-shot: existing code, no discovery state)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scope-gate.sh",
            "timeout": 30,
            "statusMessage": "Mycelium scope enforcement"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/autonomous-evidence-guard.sh",
            "timeout": 30,
            "statusMessage": "Mycelium autonomous-evidence-guard (autonomous-mode only)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/bash-state-guard.sh pre",
            "timeout": 10,
            "statusMessage": "Mycelium shell-state guard"
          }
        ]
      },
      {
        "matcher": "mcp__filesystem__(write_file|edit_file|move_file)",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/framework-guard.sh",
            "timeout": 30,
            "statusMessage": "Mycelium framework-guard (MCP filesystem — dogfood-mode only)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/autonomous-evidence-guard.sh",
            "timeout": 30,
            "statusMessage": "Mycelium autonomous-evidence-guard (MCP filesystem — autonomous-mode only)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh",
            "timeout": 30,
            "statusMessage": "Mycelium preflight gate + secret scan"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/discovery-gate.sh",
            "timeout": 30,
            "statusMessage": "Mycelium discovery gate (new source files in discovery-untouched projects)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scale-lock-gate.sh",
            "timeout": 10,
            "statusMessage": "Mycelium scale-lock gate (a new diamond opens only on what its parent established)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/brownfield-gate.sh",
            "timeout": 30,
            "statusMessage": "Mycelium brownfield gate (one-shot: existing code, no discovery state)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scope-gate.sh",
            "timeout": 30,
            "statusMessage": "Mycelium scope enforcement"
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch|mcp__brave-search__.*|mcp__fetch__fetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/read-before-research-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/post-write-nudge.sh",
            "timeout": 3,
            "statusMessage": "Mycelium post-write check"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/change-log.sh",
            "timeout": 3,
            "statusMessage": "Mycelium change log",
            "async": true
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/diamond-state-audit.sh",
            "timeout": 3,
            "statusMessage": "Mycelium diamond state audit",
            "async": true
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/canvas-schema-check.sh",
            "timeout": 10,
            "statusMessage": "Mycelium canvas schema check"
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/read-log.sh",
            "timeout": 3,
            "statusMessage": "Mycelium read log",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/bash-state-guard.sh post",
            "timeout": 15,
            "statusMessage": "Mycelium shell-state check"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/reflexion-gate.sh",
            "timeout": 10,
            "statusMessage": "Reflexion: checking failure relevance..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/stop-check.sh",
            "timeout": 5,
            "statusMessage": "Mycelium guardrail + feedback loop check"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/next-action-check.sh",
            "timeout": 5,
            "statusMessage": "Mycelium next-action check"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/ci-signal.sh"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/next-item-repeat.sh",
            "timeout": 5,
            "statusMessage": "Mycelium next-item repeat"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh --fast",
            "timeout": 60,
            "statusMessage": "Mycelium feedback loop check (fast tier)"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/ci-signal.sh --session-start"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh --async",
            "async": true,
            "statusMessage": "Mycelium feedback loop check (background tier)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/preflight.sh",
            "timeout": 5,
            "statusMessage": "Mycelium preflight stamp"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/discovery-trigger-guard.sh"
          }
        ]
      }
    ]
  }
}
