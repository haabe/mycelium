{
  "_description": "Mycelium hooks for OpenAI Codex CLI. Event names match Claude Code (PascalCase) — Codex deliberately cloned that vocabulary. Stdin field names (tool_name, tool_input, cwd, tool_response) align with Claude Code's. Scripts in this directory are reused verbatim; Codex does not export CLAUDE_PROJECT_DIR, so set it once in your shell or wrap invocations. Codex has no native PostToolUseFailure — reflexion-gate is invoked via PostToolUse and short-circuits when tool_response shows no error (see codex-postfailure-shim.sh). Symlink or copy this file to <repo>/.codex/hooks.json (or ~/.codex/hooks.json for user-level).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|edit|write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/gate.sh",
            "timeout": 5,
            "statusMessage": "Mycelium preflight gate + secret scan"
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/discovery-gate.sh",
            "timeout": 5,
            "statusMessage": "Mycelium discovery gate (new source files in discovery-untouched projects)"
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/brownfield-gate.sh",
            "timeout": 5,
            "statusMessage": "Mycelium brownfield gate (one-shot: existing code, no discovery state)"
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/scope-gate.sh",
            "timeout": 5,
            "statusMessage": "Mycelium scope enforcement"
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/framework-guard.sh",
            "timeout": 5,
            "statusMessage": "Mycelium framework-guard (dogfood-mode only)"
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/autonomous-evidence-guard.sh",
            "timeout": 5,
            "statusMessage": "Mycelium autonomous-evidence-guard (autonomous-mode only)"
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/absence-claim-guard.sh"
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/correction-attribution-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/framework-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/shell-safety-guard.sh"
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/absence-claim-guard.sh"
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/correction-attribution-guard.sh"
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch|mcp__brave-search__.*|mcp__fetch__fetch|web_search|fetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/read-before-research-guard.sh",
            "timeout": 5,
            "statusMessage": "Mycelium read-before-research check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|edit|write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/post-write-nudge.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/change-log.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/diamond-state-audit.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Read|read",
        "hooks": [
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/read-log.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/codex-postfailure-shim.sh",
            "timeout": 10,
            "statusMessage": "Reflexion: checking failure relevance (Codex shim)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/stop-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/ci-signal.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/session-start.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/ci-signal.sh --session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/preflight.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash __MYCELIUM_PLUGIN_ROOT__/hooks/discovery-trigger-guard.sh"
          }
        ]
      }
    ]
  }
}
